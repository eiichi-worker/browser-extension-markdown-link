{
    "manifest_version": 3,
    "name": "Copy Markdown Link",
    "description": "表示中のタブのLinkをMarkdown形式でコピーします",
    "version": "1.0.0",
    "default_locale": "en",
    "icons": {
        "128": "icon/icon-128.png",
        "512": "icon/icon-512.png"
    },
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "action": {
        "default_icon": {
            "128": "icon/icon-128.png",
            "512": "icon/icon-512.png"
        },
        "default_title": "Copy Markdown Link",
        "default_popup": "popup.html"
    },
    "permissions": [
        "tabs",
        "clipboardWrite",
        "contextMenus",
        "offscreen"
    ]
}